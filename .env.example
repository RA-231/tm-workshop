# Copy to .env and paste in the credential from your workshop card.
# The Bedrock API key is a bearer token: it can only call Bedrock, it expires
# on its own, and it is not an AWS access key -- no console, no S3, no IAM.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION_NAME=us-east-1

# Shared key between LibreChat and LiteLLM (any string; not a real secret here)
LITELLM_MASTER_KEY=sk-workshop
