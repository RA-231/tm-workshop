# Copy to .env and paste in the credential from your workshop card.
# The key only reaches the workshop's model project -- it is scoped and expires
# at the end of the day.
LLM_API_KEY=

# Shared key between LibreChat and LiteLLM (any string; not a real secret here)
LITELLM_MASTER_KEY=sk-workshop

# The one place a model name appears. `workshop-default` in the docs resolves to
# this; `task llm:check` confirms it is available to your key. Change it to try a
# different model, or pick any other model directly in LibreChat's picker.
WORKSHOP_DEFAULT_MODEL=openai/chat-latest
