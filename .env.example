# Copy to .env and fill in the workshop credential handed out at the session.
# These are only used by LiteLLM to reach AWS Bedrock (Steps 3-4).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Shared key between LibreChat and LiteLLM (any string; not a real secret here)
LITELLM_MASTER_KEY=sk-workshop
